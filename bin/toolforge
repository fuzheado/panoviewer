#!/bin/bash

usage() {
  echo "Fake toolforge CLI"
  echo "Usage: toolforge jobs run --image <image> --mount=all --command <command> <name>"
}

dieUsage() {
  usage 1>&2
  exit 1
}

if [ $1 != "jobs" ]; then
  dieUsage
fi

if [ $2 != "run" ]; then
  dieUsage
fi

if [ $3 != '--image' ]; then
  dieUsage
fi

image="$4"

if [ $5 != '--mount=all' ];then
  dieUsage
fi

if [ $6 != '--command' ]; then
  dieUsage
fi

command="$7"
name="$8"
dataDir="${TOOL_DATA_DIR:-$HOME}"
# The tool name used to be hardcoded, which meant the staging copy submitted its jobs to
# the LIVE tool's queue. Derive it from the data dir instead; TOOL_NAME overrides.
TOOL_NAME="${TOOL_NAME:-$(basename "$dataDir")}"

jq -n --arg name "$name" \
  --arg command "$command" \
  --arg image "$image" \
  '{name: $name, cmd: $command, imagename: $image, mount: "all"}' | \
  curl -X POST \
  -H "content-type: application/json" \
  --data @- \
  --insecure --silent --fail-with-body \
  --cert "$dataDir/.toolskube/client.crt" \
  --key "$dataDir/.toolskube/client.key" \
  "https://api.svc.tools.eqiad1.wikimedia.cloud:30003/jobs/v1/tool/${TOOL_NAME}/jobs/"

# exit status now reflects the API's answer; on failure the body is on stdout and the
# message on stderr, so a caller that checks $? (like the ported handler) can log why.
